# Copiá este archivo a .env y completá los valores reales. NUNCA commitees
# el .env real (ver .gitignore) — tiene la clave de stream de YouTube y las
# API keys de Anthropic/OpenAI.

# --- Emisión RTMP (YouTube Live → Configuración de transmisión → Clave de transmisión) ---
RTMP_URL=rtmp://a.rtmp.youtube.com/live2
RTMP_STREAM_KEY=

# --- FFmpeg (dejar por defecto salvo que el binario tenga otro nombre/ruta) ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# true en Railway/producción; false en desarrollo local
AUTOSTART=false

# --- Grilla horaria automática (ver app/core/scheduler.py) ---
# true (default): mantiene playlist.txt sincronizada con el bloque horario de
# la grilla de 24hs sin intervención manual. false: la playlist solo cambia
# a mano (POST /api/v1/playlist) — útil en desarrollo si querés controlar vos
# qué se transmite sin que el scheduler te la pise en el próximo cambio de
# bloque.
SCHEDULER_ENABLED=true

# --- Watchdog del streamer (ver app/core/watchdog.py) ---
# true (default): si ffmpeg se cae solo (corte de red, frame corrupto),
# lo reinicia automáticamente en vez de dejar la señal caída hasta que
# alguien note el corte. Ver GET /api/v1/stream/watchdog para su estado.
WATCHDOG_ENABLED=true
WATCHDOG_CHECK_INTERVAL_SEG=15
WATCHDOG_MAX_REINTENTOS=5
WATCHDOG_VENTANA_SEG=600

# --- Seguridad ---
# Protege con el header 'X-Admin-Token' los endpoints que controlan el
# stream (/stream/start|stop|reload|schedule/force), la playlist
# (altas/bajas/reorder) y la generación de contenido con IA (/ai/*, que
# gasta créditos pagos de Anthropic/OpenAI). Vacío = sin protección (uso
# local). OBLIGATORIO poner un valor propio en Railway: esa URL es pública.
ADMIN_TOKEN=

# --- LLM para guiones ---
# Se prueba Anthropic primero si ANTHROPIC_API_KEY está seteada; si no, cae a
# OpenAI; si tampoco hay OpenAI, devuelve un guion [SIMULADO] (ver ai_service.py).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- TTS para voz (Piper — motor neuronal local, sin costo ni cuota) ---
# Local: requiere pip install piper-tts (ya en requirements.txt) y el
# modelo de voz descargado a mano en TTS_MODELS_DIR (ver README, sección
# "Generar guion + voz con IA"). En Railway: el modelo default
# (es_AR-daniela-high) ya viene horneado en la imagen en /srv/tts_models
# (ver Dockerfile) — poné TTS_MODELS_DIR=/srv/tts_models ahí para que la
# app lo encuentre sin ningún paso manual post-deploy.
PIPER_BIN=piper
TTS_MODELS_DIR=media/tts
PIPER_VOICE_DEFAULT=es_AR-daniela-high

LOG_LEVEL=INFO
